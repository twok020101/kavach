# Kavach environment. Copy to `.env` at the repo root and fill in.
# Both apps read this one file. Never commit `.env`.
# Anything left empty falls back to a local mode (see README → "Running without keys").

# ── General ───────────────────────────────────────────────────────────
NODE_ENV=development
# Public URLs (used for links in WhatsApp messages and card images)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
# 1 = all Gemini calls return recorded fixtures (no Google key needed)
FAKE_LLM=1
# Shared secret for demo controls and admin endpoints
DEMO_ADMIN_KEY=change-me

# ── Google Cloud / Vertex AI (Gemini) ─────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Region for Vertex AI calls (asia-south1, or the nearest region that has the models;
# `global` had every model we need on 17 Oct 2026 except the Live ones)
GOOGLE_CLOUD_LOCATION=asia-south1
# Region for Gemini Live sessions; empty = GOOGLE_CLOUD_LOCATION. The Live models were only
# served from us-central1 on 17 Oct 2026 (not asia-south1, not global).
GOOGLE_CLOUD_LIVE_LOCATION=
# Path to a service-account JSON for local runs (Cloud Run uses its own identity)
GOOGLE_APPLICATION_CREDENTIALS=
# Model IDs: pin exact IDs on build day (see docs/implementation-plan.md §6)
KAVACH_MODEL_PRO=gemini-pro-latest-placeholder
KAVACH_MODEL_FLASH=gemini-flash-latest-placeholder
KAVACH_MODEL_LIVE=gemini-live-native-audio-placeholder
KAVACH_MODEL_TTS=gemini-tts-placeholder
KAVACH_MODEL_EMBED=gemini-embedding-placeholder
KAVACH_LIVE_VOICE=voice-name-placeholder

# ── Firebase / Firestore / Storage ────────────────────────────────────
# memory = in-process store (local dev, data lost on restart); firestore = real database
STORE=memory
# Cloud Storage bucket for uploads and generated letters; empty = local disk under .data/
GCS_BUCKET=
# Firebase web config (public values, used by the browser for anonymous sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 1 = the API accepts requests without a Firebase ID token (local dev only)
AUTH_DISABLED=1

# ── Web → API ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── WhatsApp: Meta Cloud API (test number, used for the video) ────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ── WhatsApp: Twilio Sandbox (used by judges) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# The sandbox join code shown on the landing page, e.g. "join example-word"
NEXT_PUBLIC_TWILIO_SANDBOX_JOIN=
NEXT_PUBLIC_TWILIO_SANDBOX_NUMBER=
